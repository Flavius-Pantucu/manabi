# ── Database ────────────────────────────────────────────────────────────────
# Any Postgres 13+. Add ?sslmode=require for a hosted instance (Neon, Supabase,
# RDS); leave it off locally.
DATABASE_URL="postgresql://user:password@localhost:5432/manabi"
# DATABASE_POOL_MAX=10

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs session cookies and reset tokens. Generate with:
#   openssl rand -base64 32
# Changing it invalidates every session and every outstanding reset link.
BETTER_AUTH_SECRET=""
# The app's own origin. Must match where it is served, or cookies are rejected.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (optional) ────────────────────────────────────────────────────────
# Without a key, password-reset links are printed to the server log instead of
# sent — which is enough to develop and test the whole flow.
# RESEND_API_KEY=""
# EMAIL_FROM="Manabi <no-reply@yourdomain.com>"
