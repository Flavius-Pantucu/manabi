<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.manabi.dripcommit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/flaviuspantucu/Projects/repositories/manabi/scripts/drip-commit.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/flaviuspantucu/Projects/repositories/manabi</string>

  <!-- Two runs a day, one commit each. Off-the-hour so it doesn't collide
       with everything else scheduled on :00. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>41</integer></dict>
  </array>

  <!-- If the Mac was asleep at the scheduled time, run once on wake rather
       than skipping the day entirely. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/flaviuspantucu/Projects/repositories/manabi/scripts/drip-commit.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/flaviuspantucu/Projects/repositories/manabi/scripts/drip-commit.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MAX_PER_RUN</key>
    <string>1</string>
  </dict>
</dict>
</plist>
